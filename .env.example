# Copy to backend/.env and fill in. NEVER commit the real .env file.
DATABASE_URL=postgresql+psycopg://resumefit:resumefit@localhost:5432/resumefit
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12
# Set to false ONLY for local http development; must be true in production (https)
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
